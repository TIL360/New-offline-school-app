{
  "name": "edupulse-2026",
  "version": "1.0.0",
  "description": "School Management System Offline built in Electron",
  "main": "main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "build": "electron-builder --win --x64",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "keywords": [
    "electron",
    "school",
    "offline"
  ],
  "author": "Raja Bilal",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "better-sqlite3": "^12.6.2",
    "qrcode": "^1.5.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^40.8.0",
    "electron-builder": "^26.8.1",
    "nodemon": "^3.1.14"
  },
  "build": {
    "appId": "com.kips.schoolapp",
    "productName": "EDUPULSE-2026",
    "icon": "images/icons/logo.ico",
    "artifactName": "${productName} Setup ${version} ${arch}.${ext}",
    "asar": true,
    "asarUnpack": [
      "**/*.node"
    ],
    "files": [
      "**/*",
      "!**/*.db-journal",
      "!node_modules/.cache"
    ],
    "extraResources": [
      "school.db"
    ],
    "win": {
      "icon": "images/icons/logo.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
